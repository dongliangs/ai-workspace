# ============================================================
# AI WorkSpace — 根级 .gitignore（覆盖前后端）
# ============================================================

# ---------- 依赖与构建产物（前端） ----------
**/node_modules/
**/dist/
**/dist-ssr/
**/coverage/
*.local

# ---------- 依赖与构建产物（后端 Python） ----------
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
**/venv/
**/env/
**/ENV/
build/
dist/

# ---------- 日志 ----------
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 编辑器 / IDE ----------
**/.idea/
**/.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 环境变量（不提交真实配置，保留 .example） ----------
.env
.env.*
!.env.example

# ---------- 类型检查缓存 ----------
*.tsbuildinfo

# ---------- Lint 缓存 ----------
.eslintcache
.eslintcache.*

# ---------- Cypress / Vitest 截图 ----------
/cypress/videos/
/cypress/screenshots/
__screenshots__/

# ---------- Vite 临时产物 ----------
*.timestamp-*-*.mjs

# ---------- Claude 等 AI 工具 ----------
**/.claude/
