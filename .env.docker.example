# ============================================================
# AI WorkSpace Docker 部署环境变量模板
# 用法：cp .env.docker.example .env 然后填入真实值
# 注意：.env 含密钥，已在 .gitignore 忽略，绝不提交到 git！
# ============================================================

# ---- MySQL ----
# root 密码（生成命令：openssl rand -hex 16）
MYSQL_ROOT_PASSWORD=change-me-root-password
# 业务账号密码（生成命令：openssl rand -hex 16）
MYSQL_PASSWORD=change-me-app-password

# ---- 认证 ----
# JWT 签名密钥（生成命令：openssl rand -hex 32）
# 警告：上线后不能再改，改了所有已登录用户 token 全部失效
JWT_SECRET_KEY=change-me-jwt-secret

# ---- RSA 密码解密私钥 ----
# 启动前先生成固定私钥（不要提交到 Git）：
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 \
#   -out backend/secrets/auth_rsa_private_key.pem
# docker compose 会将该文件以 secret 方式挂载到
# /run/secrets/auth_rsa_private_key.pem
# 私钥若使用口令加密，填写下面的变量；普通 PEM 保持为空
RSA_PRIVATE_KEY_PASSWORD=

# ---- DeepSeek LLM ----
# 从 backend/.env 里复制你现有的值
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
